{
  "name": "vantrangedu-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build",
    "build:prod": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "deploy": "npm install && npm run build:prod && npx wrangler pages deploy dist --project-name=vantrangedu --branch=main --commit-dirty=true",
    "deploy:quick": "npm run build:prod && npx wrangler pages deploy dist --project-name=vantrangedu --branch=main --commit-dirty=true",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.21",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "heic2any": "^0.0.4",
    "jscanify": "^1.4.2",
    "lucide-react": "^1.17.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.71.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.4.0",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@types/prop-types": "15.7.12",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.148.0"
  }
}
