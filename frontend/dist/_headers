/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=self, microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://docs.opencv.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; connect-src 'self' https://vantrangedu-api.bangachieu2.workers.dev https://files.vantrangedu.com https://www.google-analytics.com https://*.r2.cloudflarestorage.com https://imagedelivery.net https://docs.opencv.org; font-src 'self' data: https://fonts.gstatic.com; worker-src blob:; media-src 'self' blob: https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://maps.google.com; frame-ancestors 'none'

# HTML files must never be cached — stale index.html causes MIME-type errors
# when lazy-loaded JS chunks have new hashes after a deploy.
/index.html
  Cache-Control: no-store, no-cache, must-revalidate

/
  Cache-Control: no-store, no-cache, must-revalidate

# Hashed assets are immutable — cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/register
  Permissions-Policy: camera=self, microphone=(), geolocation=()
