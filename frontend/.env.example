# ============================================================
# Van Trang Education — Frontend Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to git.
# ============================================================

# --- API ---
# Backend API base URL.
# For the Cloudflare Pages production site, keep this as `/api` so requests
# stay same-origin and pass through `frontend/functions/api/[[path]].js`.
VITE_API_URL=/api

# --- Google Analytics 4 ---
# Create a GA4 property at https://analytics.google.com
# Measurement ID format: G-XXXXXXXXXX
# Leave empty to disable GA4 gracefully (no errors thrown)
VITE_GA4_ID=G-XXXXXXXXXX

# Legacy alias — same as VITE_GA4_ID (kept for backward compatibility)
VITE_GA4_MEASUREMENT_ID=

# --- Microsoft Clarity (heatmaps & session recordings) ---
# Create a project at https://clarity.microsoft.com
# Project ID is the short alphanumeric string in the embed snippet
# Leave empty to disable Clarity
VITE_CLARITY_PROJECT_ID=

# --- Facebook Pixel (optional) ---
# Get Pixel ID from https://business.facebook.com/events_manager
# Leave empty to disable FB Pixel
VITE_FB_PIXEL_ID=
