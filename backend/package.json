{
  "name": "vantrangedu-api",
  "version": "1.0.0",
  "description": "Cloudflare Worker API for Student Registration System",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm install && npx wrangler deploy",
    "deploy:quick": "npx wrangler deploy",
    "db:init": "wrangler d1 execute DB --file=./schema.sql",
    "db:migrate:0023": "wrangler d1 execute DB --remote --file=./migrations/0023_program_platform.sql",
    "db:migrate:0024": "wrangler d1 execute DB --remote --file=./migrations/0024_auth_sessions_sso.sql",
    "db:migrate:0025": "wrangler d1 execute DB --remote --file=./migrations/0025_program_capabilities_and_class_sessions.sql",
    "db:migrate:0026": "wrangler d1 execute DB --remote --file=./migrations/0026_merge_teachers_into_admins.sql",
    "db:migrate:0029": "wrangler d1 execute DB --remote --file=./migrations/0029_add_zoom_link_backups_to_exam_schedules.sql",
    "db:migrate:0030": "wrangler d1 execute DB --remote --file=./migrations/0030_add_zoom_backup_credentials_to_exam_schedules.sql",
    "db:migrate:0031": "wrangler d1 execute DB --remote --file=./migrations/0031_source_site_documents_assignments_notifications.sql",
    "db:migrate:0032": "wrangler d1 execute DB --remote --file=./migrations/0032_add_video_url_to_posts.sql",
    "db:migrate:0039": "wrangler d1 execute DB --remote --file=./migrations/0039_photo_3x4_ai_pipeline.sql",
    "db:migrate:0040": "wrangler d1 execute DB --remote --file=./migrations/0040_photo_3x4_generate_first.sql",
    "add-exams": "node scripts/add-exams-cli.ts",
    "test": "vitest"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "d1",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.12.3",
    "vantrangedu-api": "file:",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20260305.0",
    "@types/bcryptjs": "^2.4.6",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0",
    "wrangler": "^4.76.0"
  },
  "optionalDependencies": {
    "@cloudflare/workerd-windows-64": "^1.20260305.0"
  }
}
